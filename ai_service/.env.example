# --- ai_service: пример конфигурации. Скопируйте в .env и заполните. ---

# HTTP-сервер
HOST=0.0.0.0
PORT=8100

# Очередь
QUEUE_MAX_SIZE=100
REQUEST_TIMEOUT_S=120

# Playwright / Google
HEADLESS=true
LOCALE=ru-RU
NAV_TIMEOUT_MS=30000
AI_OVERVIEW_TIMEOUT_MS=20000
EXPAND_OVERVIEW=true
# Постоянный профиль браузера (cookie/consent сохраняются между запросами).
# Если Google покажет капчу — один раз запустите с HEADLESS=false и решите её
# вручную в этом профиле, дальше выдача открывается сама.
USER_DATA_DIR=./ai_service/profile
# channel=chrome — установленный Google Chrome (менее детектится). Пусто — Chromium.
BROWSER_CHANNEL=chrome
WARMUP_HOMEPAGE=true
# Сохранять скриншот+html, когда обзор не найден (для отладки селекторов)
DEBUG_DUMPS=false

# --- Ретраи получения «Обзора от ИИ» (внешнего fallback нет) ---
# Сколько раз пытаться получить обзор, прежде чем вернуть 502.
OVERVIEW_MAX_RETRIES=3
# Базовая пауза между попытками, сек (растёт линейно: delay * номер попытки).
OVERVIEW_RETRY_DELAY_S=5

# --- Telegram-уведомления о капче ---
# При капче сервис зовёт человека в тот же телеграм-канал, что и парсеры
# (общий конфиг shared_storage/telegram_config.toml). Пусто/нет файла — выкл.
TELEGRAM_CONFIG_PATH=./shared_storage/telegram_config.toml

# --- Авто-восстановление при капче ---
# При капче сервис открывает ВИДИМОЕ окно на рабочем столе сервера (DISPLAY),
# шлёт напоминание в Telegram раз в час и ЖДЁТ ручного решения, затем продолжает.
CAPTCHA_RECOVERY_ENABLED=true
# Напоминание в Telegram раз в N секунд, пока капчу не решат (по умолчанию — час).
CAPTCHA_REMINDER_INTERVAL_S=3600
# Как часто проверять, решена ли капча, сек.
CAPTCHA_POLL_INTERVAL_S=15
# Максимум ожидания решения, сек (0 — ждать бесконечно).
CAPTCHA_RECOVERY_TIMEOUT_S=0
# Нейтральный запрос, который открываем в окне для решения капчи.
CAPTCHA_PROBE_QUERY=погода ростов на неделю

# --- Резерв: DuckDuckGo AI Chat (duck.ai) ---
# Без логина/капчи. Используется, когда Google не отдал «Обзор» (капча/нет блока),
# в том же браузере. Конвейер не встаёт, даже если Google закапчен.
DUCKDUCKGO_ENABLED=true
# Таймаут ожидания ответа duck.ai (стрим), мс.
DUCKDUCKGO_GEN_TIMEOUT_MS=90000
